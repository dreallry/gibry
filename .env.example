# Browser configuration; these Firebase values are public project identifiers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false
VITE_API_BASE_URL=

# Server configuration. Never add VITE_ to server keys or service account credentials.
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Vercel cron authorization; use a random secret of at least 32 characters.
CRON_SECRET=
